---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Interactive Banner", subtitle = "Hover to interact" } = Astro.props;
---

<div class="relative w-full overflow-hidden rounded-xl bg-linear-to-br from-slate-900 via-purple-900 to-slate-900">
  <canvas
    id="interactive-canvas"
    class="block w-full h-80 cursor-pointer"
    data-title={title}
    data-subtitle={subtitle}></canvas>
</div>

<script>
  import { initInteractiveCanvasBanner } from "./interactive-canvas-banner";

  const canvas = document.getElementById('interactive-canvas');

  if (canvas instanceof HTMLCanvasElement) {
    initInteractiveCanvasBanner(canvas);
  }
</script>
