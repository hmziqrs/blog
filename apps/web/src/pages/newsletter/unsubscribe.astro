---
import { pageTitle } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "../../components/PageContainer.astro";

const title = pageTitle("Unsubscribe");
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<BaseLayout
  title={title}
  description="Stop receiving newsletter emails. You can resubscribe anytime."
  noindex={true}
>
  <PageContainer>
    <main class="mx-auto max-w-2xl px-4 py-16 text-center">
      <div id="loading">
        <h1 class="mb-4 text-3xl font-bold">Unsubscribing…</h1>
        <p class="text-base-content/70">
          Processing your request. This won't take long.
        </p>
        <p class="mt-2 text-sm text-soft">
          You will stop receiving newsletter emails.
          <a href="/newsletter" class="text-primary hover:underline">Re-subscribe anytime</a>.
        </p>
      </div>
      <div id="success" class="hidden">
        <h1 class="mb-4 text-3xl font-bold">Successfully Unsubscribed</h1>
        <p class="text-base-content/70">
          You've been removed from the newsletter. Sorry to see you go.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-primary">Back to blog</a>
          <a href="/contact" class="btn btn-ghost">Contact us</a>
        </div>
      </div>
      <div id="error" class="hidden">
        <h2 class="mb-4 text-3xl font-bold">Unsubscribe failed</h2>
        <p id="error-msg" class="text-error"></p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-ghost">Back to blog</a>
          <a href="/contact" class="btn btn-ghost">Contact support</a>
          <a href="/privacy" class="btn btn-ghost">Privacy policy</a>
        </div>
      </div>
    </main>
  </PageContainer>
</BaseLayout>

<script define:vars={{ apiBase }}>
  (async () => {
    const token = new URLSearchParams(location.search).get("token");
    const $loading = document.getElementById("loading");
    const $success = document.getElementById("success");
    const $error = document.getElementById("error");
    const $msg = document.getElementById("error-msg");

    if (!token) {
      $loading.classList.add("hidden");
      $error.classList.remove("hidden");
      $msg.textContent = "No unsubscribe token provided.";
      return;
    }

    try {
      const res = await fetch(`${apiBase}/api/newsletter/unsubscribe?token=${encodeURIComponent(token)}`);
      const data = await res.json();
      $loading.classList.add("hidden");
      if (res.ok) {
        $success.classList.remove("hidden");
      } else if (res.status === 429) {
        $error.classList.remove("hidden");
        const retryAfter = data.retryAfter || 3600;
        const m = Math.floor(retryAfter / 60);
        const s = retryAfter % 60;
        $msg.textContent = `Too many attempts. Please try again in ${m > 0 ? `${m}m ${s}s` : `${s}s`}.`;
      } else {
        $error.classList.remove("hidden");
        $msg.textContent = data.error || "Something went wrong.";
      }
    } catch {
      $loading.classList.add("hidden");
      $error.classList.remove("hidden");
      $msg.textContent = "Network error. Please try again.";
    }
  })();
</script>
