---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { pageTitle, siteConfig } from "../config/site";
import PageContainer from "../components/PageContainer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = await getCollection("changelogs");
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = entries[0];

const title = pageTitle("Changelog");

// Category definitions with visual styling
const categoryDefs = [
  { key: "added", label: "Added", icon: "tabler:plus", color: "text-emerald-400", bg: "bg-emerald-500/10", border: "border-emerald-500/20", dot: "bg-emerald-400" },
  { key: "changed", label: "Changed", icon: "tabler:refresh", color: "text-sky-400", bg: "bg-sky-500/10", border: "border-sky-500/20", dot: "bg-sky-400" },
  { key: "deprecated", label: "Deprecated", icon: "tabler:alert-triangle-filled", color: "text-amber-400", bg: "bg-amber-500/10", border: "border-amber-500/20", dot: "bg-amber-400" },
  { key: "removed", label: "Removed", icon: "tabler:minus", color: "text-red-400", bg: "bg-red-500/10", border: "border-red-500/20", dot: "bg-red-400" },
  { key: "fixed", label: "Fixed", icon: "tabler:tool", color: "text-violet-400", bg: "bg-violet-500/10", border: "border-violet-500/20", dot: "bg-violet-400" },
  { key: "security", label: "Security", icon: "tabler:shield-check", color: "text-orange-400", bg: "bg-orange-500/10", border: "border-orange-500/20", dot: "bg-orange-400" },
] as const;

// Pre-process entries so the template never needs type assertions
interface RenderedEntry {
  version: string | undefined;
  date: Date;
  dateStr: string;
  title: string;
  body: string | undefined;
  sections: Array<{
    label: string;
    icon: string;
    color: string;
    bg: string;
    border: string;
    dot: string;
    items: string[];
  }>;
  useCategories: boolean;
}

const rendered: RenderedEntry[] = entries.map((entry) => {
  const d = entry.data;
  const dateStr = d.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

  const sections = categoryDefs
    .filter((cat) => {
      const items = d[cat.key];
      return Array.isArray(items) && items.length > 0;
    })
    .map((cat) => ({
      label: cat.label,
      icon: cat.icon,
      color: cat.color,
      bg: cat.bg,
      border: cat.border,
      dot: cat.dot,
      items: d[cat.key] ?? [],
    }));

  return {
    version: d.version,
    date: d.date,
    dateStr,
    title: d.title,
    body: entry.body,
    sections,
    useCategories: sections.length > 0,
  };
});
---

<BaseLayout title={title} description={`Release history for ${siteConfig.name}.`}>
  <PageContainer>
    <section class="px-4 py-8 sm:py-10">
      <header class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold">Changelog</h1>
        {
          latest && (
            <p class="mt-1 text-sm text-base-content/50">
              Latest <span class="font-mono font-medium text-primary/80">v{latest.data.version}</span>
            </p>
          )
        }
      </header>

      {
        rendered.length === 0 ? (
          <div class="rounded-xl border border-base-content/10 bg-base-200/60 backdrop-blur-xl p-6 text-center">
            <p class="text-base-content/40 text-sm">No releases yet.</p>
          </div>
        ) : (
          <div class="relative">
            <!-- Vertical timeline line (desktop only) -->
            <div class="absolute left-[0.95rem] top-1 bottom-1 w-px bg-base-content/8 hidden sm:block" aria-hidden="true"></div>
            <div class="space-y-5 sm:space-y-6">
              {rendered.map((entry) => (
                <article class="relative pl-0 sm:pl-10">
                  <!-- Timeline dot (desktop only) -->
                  <div class="absolute left-1.5 top-1.5 w-[1.15rem] h-[1.15rem] rounded-full border border-base-content/10 bg-base-200/60 backdrop-blur-xl hidden sm:flex items-center justify-center">
                    <div class="w-1.5 h-1.5 rounded-full bg-primary/50"></div>
                  </div>
                  <!-- Card -->
                  <div class="rounded-xl border border-base-content/10 bg-base-200/60 backdrop-blur-xl overflow-hidden">
                    <div class="p-5 sm:p-6">
                      <!-- Header: version + date -->
                      <div class="flex flex-wrap items-center gap-2.5 mb-3">
                        <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 font-mono text-xs font-semibold tracking-wide uppercase text-primary/80">
                          <span class="w-1 h-1 rounded-full bg-primary/50 mr-1.5 sm:hidden"></span>
                          v{entry.version}
                        </span>
                        <time class="font-mono text-xs tracking-wide uppercase text-base-content/45" datetime={entry.date.toISOString()}>
                          {entry.dateStr}
                        </time>
                      </div>
                      <h2 class="text-base sm:text-lg font-semibold mb-4 text-base-content/90">{entry.title}</h2>

                      {/* Categorized sections */}
                      {entry.useCategories && entry.sections.map((section) => (
                        <div class="mb-4 last:mb-0">
                          <div class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[0.65rem] font-semibold tracking-wide uppercase mb-2.5 ${section.border} ${section.bg} ${section.color}`}>
                            <Icon name={section.icon} class="w-3.5 h-3.5" />
                            {section.label}
                          </div>
                          <ul class="space-y-2">
                            {section.items.map((item) => (
                              <li class="flex items-start gap-3 text-sm leading-relaxed text-base-content/70">
                                <span class={`mt-2 w-1.5 h-1.5 rounded-full shrink-0 ${section.dot}`}></span>
                                {item}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}

                      {/* Fallback for entries with body but no categories */}
                      {!entry.useCategories && entry.body && (
                        <div class="mt-3 text-sm leading-relaxed text-base-content/70 [&_ul]:space-y-2 [&_li]:flex [&_li]:gap-3 [&_li::before]:content-[''] [&_li::before]:mt-2 [&_li::before]:w-1.5 [&_li::before]:h-1.5 [&_li::before]:rounded-full [&_li::before]:bg-primary/40 [&_li::before]:shrink-0">
                          <Fragment set:html={entry.body} />
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )
      }
    </section>
  </PageContainer>
</BaseLayout>
