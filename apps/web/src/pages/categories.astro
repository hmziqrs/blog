---
import { getCollection } from "astro:content";
import { pageTitle, routes, siteConfig } from "../config/site";
import BadgeLink from "../components/BadgeLink.astro";
import PageContainer from "../components/PageContainer.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { countSortedValues } from "../utils/posts";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = countSortedValues(posts.map((post) => post.data.category));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Blog Categories",
  description: `Browse all blog categories on ${siteConfig.name}`,
  url: `${siteConfig.publicSiteUrl}/categories`,
  isPartOf: { "@type": "WebSite", "@id": `${siteConfig.publicSiteUrl}/#website` },
};
---

<BaseLayout
  title={pageTitle("Blog Categories — Browse by Topic")}
  description={`Browse ${categories.length} categories on ${siteConfig.name}. Find posts organized by topic including web development, cloud infrastructure, developer tooling, and more.`}
  structuredData={collectionSchema}
>
  <PageContainer>
    <PageHeader title="Blog Categories — Browse by Topic" description={`Browse ${categories.length} categories on ${siteConfig.name}. Find posts organized by topic.`} class="mb-8" />
    {
      categories.length === 0 ? (
        <p class="text-muted text-sm">No categories yet.</p>
      ) : (
        <div class="flex flex-wrap gap-3">
          {categories.map(([category, count]) => (
            <BadgeLink
              href={routes.category(category)}
              variant="accent"
              size="lg"
              class="capitalize gap-2"
            >
              {category}
              <span class="opacity-65">{count}</span>
            </BadgeLink>
          ))}
        </div>
      )
    }
  </PageContainer>
</BaseLayout>
