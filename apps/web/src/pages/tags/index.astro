---
import { getCollection } from "astro:content";
import { pageTitle, siteConfig } from "../../config/site";
import PageContainer from "../../components/PageContainer.astro";
import PageHeader from "../../components/PageHeader.astro";
import TagBadge from "../../components/TagBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countSortedValues } from "../../utils/posts";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = countSortedValues(posts.flatMap((post) => post.data.tags));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "All Tags",
  description: `Browse all blog topics and tags on ${siteConfig.name}`,
  url: `${siteConfig.publicSiteUrl}/tags`,
  isPartOf: { "@type": "WebSite", "@id": `${siteConfig.publicSiteUrl}/#website` },
};
---

<BaseLayout
  title={pageTitle("Tags")}
  description={`All ${tags.length} tags on ${siteConfig.name}.`}
  structuredData={collectionSchema}
>
  <PageContainer>
    <PageHeader title="Tags" description={`${tags.length} topics across all posts.`} class="mb-8" />
    {
      tags.length === 0 ? (
        <p class="text-muted text-sm">No tags yet.</p>
      ) : (
        <div class="flex flex-wrap gap-3">
          {tags.map(([tag, count]) => (
            <TagBadge tag={tag} count={count} size="large" />
          ))}
        </div>
      )
    }
  </PageContainer>
</BaseLayout>
